# =============================================================================
# Flash-Sale Engine — Environment variables (template, KHÔNG chứa giá trị thật)
# Sao chép file này thành .env và điền giá trị thật cho môi trường local.
# =============================================================================

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080

# PostgreSQLPrimary (ghi Order + Outbox)
POSTGRESQL_PRIMARY_CONNECTION_STRING=Host=localhost;Port=5432;Database=flashsale;Username=postgres;Password=your_primary_password

# ReadReplica (chỉ đọc)
POSTGRESQL_REPLICA_CONNECTION_STRING=Host=localhost;Port=5433;Database=flashsale_replica;Username=postgres;Password=your_replica_password

# Redis Cluster (RateLimit state + Inventory)
REDIS_CONNECTION_STRING=localhost:6379

# RabbitMQ (OrderPipeline + DeadLetterQueue)
RABBITMQ_CONNECTION_STRING=amqp://guest:guest@localhost:5672/
RABBITMQ_QUEUE_NAME=order_pipeline_queue
RABBITMQ_EXCHANGE_NAME=flash_sale_exchange
RABBITMQ_ROUTING_KEY=order.created

# Rate Limit (dev thấp, production theo spike 15.000 RPS)
RATE_LIMIT_RPS=100

# Correlation ID header
CORRELATION_ID_HEADER=Correlation-Id
