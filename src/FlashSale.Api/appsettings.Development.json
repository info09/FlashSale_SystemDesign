{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Debug"
    }
  },
  "ConnectionStrings": {
    "PostgreSQLPrimary": "Host=localhost;Port=5432;Database=flashsale;Username=postgres;Password=your_postgres_password",
    "ReadReplica": "Host=localhost;Port=5433;Database=flashsale_replica;Username=postgres;Password=your_postgres_password"
  },
  "Redis": {
    "ConnectionString": "localhost:6379,localhost:6380,localhost:6381"
  },
  "RabbitMQ": {
    "ConnectionString": "amqp://guest:guest@localhost:5672/"
  },
  "RateLimit": {
    "Rps": "100"
  },
  "Jwt": {
    "Secret": "your_jwt_secret_key_at_least_32_characters_long_for_hmac_sha256",
    "Issuer": "FlashSale.Api",
    "Audience": "FlashSale.Client",
    "ExpirationMinutes": "60"
  }
}
