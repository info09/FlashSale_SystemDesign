{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "PostgreSQLPrimary": "${POSTGRESQL_PRIMARY_CONNECTION_STRING}",
    "ReadReplica": "${POSTGRESQL_REPLICA_CONNECTION_STRING}"
  },
  "Redis": {
    "ConnectionString": "${REDIS_CONNECTION_STRING}"
  },
  "RabbitMQ": {
    "ConnectionString": "${RABBITMQ_CONNECTION_STRING}",
    "QueueName": "${RABBITMQ_QUEUE_NAME}",
    "ExchangeName": "${RABBITMQ_EXCHANGE_NAME}",
    "RoutingKey": "${RABBITMQ_ROUTING_KEY}"
  },
  "RateLimit": {
    "Rps": "${RATE_LIMIT_RPS}"
  },
  "CorrelationIdHeader": "${CORRELATION_ID_HEADER}"
}
